# Copy to .env for local development; set actual values in Vercel Environment Variables.
# The server reads these names. Never rename OPENAI_API_KEY to a VITE_* variable.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
OPENAI_API_KEY=REPLACE_WITH_SERVER_ONLY_API_KEY
# Optional; replace with an available model ID or omit to use the server default.
# OPENAI_MODEL=YOUR_MODEL_ID
KROK_GOOGLE_AUTH=false

# Hosted API policy: exact HTTPS origins, comma-separated; no wildcard or URL path.
KROK_ALLOWED_ORIGINS=https://your-project.vercel.app
# Only these verified Supabase email accounts may use paid AI endpoints.
KROK_AI_ALLOWED_EMAILS=beta-tester@example.com
# Durable per-user limits, global budget and stop switch stored in Supabase. Only the exact
# value "enforce" enables them; anything else keeps the in-memory per-instance limits only.
# Apply supabase/migrations/20261118120000_ai_usage.sql to the project FIRST: while enabled,
# a missing or failing usage check closes paid AI requests (503 usage_unavailable).
# No service-role key is needed or accepted; limits are edited in public.krok_ai_limits.
# KROK_AI_USAGE=enforce

# VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL are supplied by Vercel itself.
# Do not commit a filled .env, provider secrets, session tokens or real user addresses.
