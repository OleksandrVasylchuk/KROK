{
  "name": "krok",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/generate-icons.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "test": "node --test src/*.test.js scripts/*.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource/manrope": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.3"
  }
}
